---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import { TAG_GROUPS, tagHref } from '../../../data/post-tags';
import PostSectionNav from '../../../components/PostSectionNav.astro';
import '../../../styles/post-index.css';
import '../../../styles/post-tags.css';

const posts = await getCollection('blog', ({ data }) => data.lang === 'ja');
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) || 0) + 1);
const known = new Set(TAG_GROUPS.flatMap(g => g.tags));
const stray = [...counts.keys()].filter(tag => !known.has(tag));
const groups = [...TAG_GROUPS, ...(stray.length ? [{ key: 'other', en: 'OTHER', label: 'その他', description: 'まだ地図に載っていないタグ。', tags: stray }] : [])]
  .map(group => {
    const tags = group.tags.filter(tag => counts.get(tag)).map(tag => ({ tag, count: counts.get(tag)! })).sort((a, b) => b.count - a.count);
    const reach = posts.filter(post => post.data.tags.some(tag => group.tags.includes(tag))).length;
    return { ...group, tags, reach };
  })
  .filter(group => group.tags.length);
const topicGroups = groups.filter(g => g.key !== 'format');
const formatGroup = groups.find(g => g.key === 'format');
const max = Math.max(...topicGroups.flatMap(g => g.tags.map(t => t.count)));
const tagTotal = groups.reduce((sum, g) => sum + g.tags.length, 0);
---
<EditorialLayout title="タグ地図" description="記事のタグを、暮らし・学び・つくる・仕事・旅・表現の6つの領域に整理した地図。" hideHeader>
  <div class="post-index tag-map-page">
    <header class="index-title"><span class="display-type">01</span><h1>タグ地図</h1><p>{tagTotal} タグ · {posts.length} 記事</p></header>
    <PostSectionNav current="tags" />

    <p class="tag-map-lede">書いてきたことを6つの領域に分けました。数字は記事数、線の長さはその量です。</p>

    <div class="tag-regions">
      {topicGroups.map(group => (
        <section class="tag-region" aria-labelledby={'region-' + group.key}>
          <header>
            <span class="display-type tag-region-en" aria-hidden="true">{group.en}</span>
            <h2 id={'region-' + group.key}>{group.label}</h2>
            <p>{group.description}</p>
            <span class="tag-region-reach">{group.reach} 記事</span>
          </header>
          <ul>
            {group.tags.map(({ tag, count }) => (
              <li>
                <a href={tagHref(tag)}>
                  <span class="tag-name">#{tag}</span>
                  <span class="tag-count">{count}</span>
                  <span class="tag-bar" style={`--w:${Math.max(4, Math.round(count / max * 100))}%`} aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    {formatGroup && (
      <section class="tag-formats" aria-labelledby="region-format">
        <h2 id="region-format"><span class="display-type" aria-hidden="true">{formatGroup.en}</span>{formatGroup.label}</h2>
        <p>{formatGroup.description}</p>
        <div>{formatGroup.tags.map(({ tag, count }) => <a href={tagHref(tag)}>#{tag}<span>{count}</span></a>)}</div>
      </section>
    )}

    <p class="tag-map-foot"><a href="/blog">記事一覧で年・月と組み合わせて絞り込む<Icon name="lucide:arrow-up-right" /></a></p>
  </div>
</EditorialLayout>
