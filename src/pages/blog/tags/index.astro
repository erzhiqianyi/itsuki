---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import PostSectionNav from '../../../components/PostSectionNav.astro';
import { areaHref, tagAreas, tagHref } from '../../../data/post-tags';
import '../../../styles/post-index.css';
import '../../../styles/post-tags.css';

const posts = await getCollection('blog', ({ data }) => data.lang === 'ja');
const areas = tagAreas(posts);
const topicAreas = areas.filter(a => a.key !== 'format');
const formatArea = areas.find(a => a.key === 'format');
const tagTotal = areas.reduce((sum, a) => sum + a.tags.length, 0);
---
<EditorialLayout title="タグ地図" description="記事のタグを、暮らし・学び・つくる・仕事・旅・表現の6つの領域に整理した地図。" hideHeader>
  <div class="post-index tag-map-page">
    <header class="index-title"><span class="display-type">01</span><h1>タグ地図</h1><p>{topicAreas.length} 領域 · {tagTotal} タグ · {posts.length} 記事</p></header>
    <PostSectionNav current="tags" />

    <p class="tag-map-lede">書いてきたことを{topicAreas.length}つの領域に分けました。領域を選ぶと、その中のタグが見られます。</p>

    <ul class="tag-areas">
      {topicAreas.map((area, i) => (
        <li>
          <a class="tag-area" href={areaHref(area.key)}>
            <span class="tag-area-top"><span class="tag-area-icon"><Icon name={'lucide:' + area.icon} /></span><span class="display-type tag-area-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></span>
            <span class="display-type tag-area-en" aria-hidden="true">{area.en}</span>
            <strong>{area.label}</strong>
            <span class="tag-area-count"><b class="display-type">{area.posts.length}</b> 記事<span aria-hidden="true">·</span>{area.tags.length} タグ</span>
            <span class="tag-area-peek">{area.tags.slice(0, 3).map(t => '#' + t.tag).join('　')}</span>
            <span class="tag-area-go">タグを見る<Icon name="lucide:arrow-right" /></span>
          </a>
        </li>
      ))}
    </ul>

    {formatArea && (
      <section class="tag-formats" aria-labelledby="region-format">
        <h2 id="region-format"><span class="display-type" aria-hidden="true">{formatArea.en}</span>{formatArea.label}</h2>
        <p>{formatArea.description}</p>
        <div>{formatArea.tags.map(({ tag, count }) => <a href={tagHref(tag)}>#{tag}<span>{count}</span></a>)}</div>
      </section>
    )}

    <p class="tag-map-foot"><a href="/blog">記事一覧で年・月と組み合わせて絞り込む<Icon name="lucide:arrow-up-right" /></a></p>
  </div>
</EditorialLayout>
