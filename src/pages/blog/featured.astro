---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import PostSectionNav from '../../components/PostSectionNav.astro';
import { postCategoryLabel as label } from '../../lib/post-filter';
import { FORMAT_TAGS, tagHref } from '../../data/post-tags';
import '../../styles/post-index.css';
import '../../styles/post-featured.css';

const featured = (await getCollection('blog', ({ data }) => data.lang === 'ja' && data.featured))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id));

const readingMinutes = (body = '') => Math.max(1, Math.ceil((body.match(/[぀-ヿ一-鿿]|\w+/g)?.length || 0) / 400));
const items = featured.map(post => {
  const cover = post.data.coverImage && existsSync(join(process.cwd(), 'public', post.data.coverImage)) ? post.data.coverImage : '';
  return {
    href: '/blog/' + post.id.replace(/\.(md|mdx)$/, ''),
    title: post.data.title || post.data.date,
    date: post.data.date,
    category: post.data.category.toLowerCase(),
    summary: post.data.summary && !post.data.summary.includes('準備中') ? post.data.summary : '',
    tags: post.data.tags.filter(tag => !FORMAT_TAGS.has(tag)).slice(0, 2),
    cover,
    minutes: readingMinutes(post.body),
  };
});
const [lead, ...rest] = items;
const years = [...new Set(rest.map(item => item.date.slice(0, 4)))];
---
<EditorialLayout title="おすすめ" description="これまでの記事から選んだ、読んでほしい記事。" hideHeader>
  <div class="post-index featured-page">
    <header class="index-title"><span class="display-type">01</span><h1>おすすめ</h1><p>{items.length} 記事</p></header>
    <PostSectionNav current="featured" />

    {lead && (
      <article class="featured-lead">
        <a class="featured-cover" href={lead.href} tabindex="-1" aria-hidden="true">{lead.cover ? <img src={lead.cover} alt="" loading="eager" /> : <span class="display-type">{lead.category.toUpperCase()}</span>}</a>
        <div>
          <p class="featured-kicker"><span class="display-type">LATEST PICK</span><time datetime={lead.date}>{lead.date.replaceAll('-', '.')}</time></p>
          <h2><a href={lead.href}>{lead.title}</a></h2>
          {lead.summary && <p class="featured-summary">{lead.summary}</p>}
          <p class="featured-meta"><a href={'/category/' + lead.category}>{label(lead.category)}</a><span>{lead.minutes} 分で読める</span>{lead.tags.map(tag => <a href={tagHref(tag)}>#{tag}</a>)}</p>
        </div>
      </article>
    )}

    {years.map(year => (
      <section class="featured-year" aria-labelledby={'featured-' + year}>
        <h2 id={'featured-' + year} class="display-type">{year}</h2>
        <div class="featured-grid">
          {rest.filter(item => item.date.startsWith(year)).map(item => (
            <article class="featured-card">
              <a class="featured-cover" href={item.href} tabindex="-1" aria-hidden="true">{item.cover ? <img src={item.cover} alt="" loading="lazy" /> : <span class="display-type">{item.category.toUpperCase()}</span>}</a>
              <p class="featured-kicker"><time datetime={item.date}>{item.date.replaceAll('-', '.')}</time><a href={'/category/' + item.category}>{label(item.category)}</a></p>
              <h3><a href={item.href}>{item.title}</a></h3>
              {item.summary && <p class="featured-summary">{item.summary}</p>}
              {item.tags.length > 0 && <p class="featured-meta">{item.tags.map(tag => <a href={tagHref(tag)}>#{tag}</a>)}</p>}
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="tag-map-foot featured-foot"><a href="/blog">すべての記事を見る<Icon name="lucide:arrow-up-right" /></a></p>
  </div>
</EditorialLayout>
