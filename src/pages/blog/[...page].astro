---
import { getCollection } from 'astro:content';
import PostIndex from '../../components/PostIndex.astro';
import { SITE_CONFIG } from '../../data/site-config';
export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'ja');
  return paginate(posts.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date)), { pageSize: SITE_CONFIG.blog.pageSize });
}
const { page } = Astro.props;
---
<PostIndex page={page} />
