---
// Every article on one page — date and title only, newest first, no pagination.
import { getCollection } from 'astro:content';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PostSectionNav from '../components/PostSectionNav.astro';
import '../styles/post-index.css';
import '../styles/post-archive.css';

const posts = (await getCollection('blog', ({ data }) => data.lang === 'ja'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id));
const years = [...new Set(posts.map(p => p.data.date.slice(0, 4)))];
const byYear = years.map(year => {
  const yearPosts = posts.filter(p => p.data.date.startsWith(year));
  const months = [...new Set(yearPosts.map(p => p.data.date.slice(5, 7)))];
  return { year, count: yearPosts.length, months: months.map(month => ({ month, posts: yearPosts.filter(p => p.data.date.slice(5, 7) === month) })) };
});
const href = (post: typeof posts[number]) => '/blog/' + post.id.replace(/\.(md|mdx)$/, '');
---
<EditorialLayout title="アーカイブ" description="これまでのすべての記事を、日付とタイトルで一覧にしています。" hideHeader>
  <div class="post-index archive-page">
    <header class="index-title"><span class="display-type">01</span><h1>アーカイブ</h1><p>{posts.length} 記事</p></header>
    <PostSectionNav current="archive" />
    <nav class="archive-years" aria-label="年へ移動">{byYear.map(({ year, count }) => <a href={'#y' + year}><span class="display-type">{year}</span><small>{count}</small></a>)}</nav>

    {byYear.map(({ year, count, months }) => (
      <section class="archive-year" id={'y' + year} aria-labelledby={'yh' + year}>
        <h2 id={'yh' + year}><span class="display-type">{year}</span><small>{count} 記事</small></h2>
        {months.map(({ month, posts }) => (
          <div class="archive-month">
            <h3 class="display-type">{Number(month)}月</h3>
            <ol>
              {posts.map(post => (
                <li><time datetime={post.data.date}>{post.data.date.slice(5).replace('-', '.')}</time><a href={href(post)}>{post.data.title || post.data.date}</a></li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>
</EditorialLayout>
