---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import '../../styles/photography.css';
export async function getStaticPaths() {
  const albums = (await getCollection('photos')).sort((a,b) => Date.parse(b.data.date) - Date.parse(a.data.date));
  return albums.map((entry,index) => ({ params: { slug: entry.slug }, props: { entry, next: albums[index + 1], previous: albums[index - 1], number: index + 1 } }));
}
const { entry, next, previous, number } = Astro.props;
const { Content } = await render(entry);
const locale = value => typeof value === 'string' ? value : value?.ja || value?.en || '';
const title = locale(entry.data.title);
const images = entry.data.images?.length ? entry.data.images : entry.data.cover ? [{url:entry.data.cover,title}] : [];
---
<EditorialLayout title={title} description={locale(entry.data.description) || title} image={entry.data.cover}>
  <a class="photo-back" href="/photos"><Icon name="lucide:arrow-left" />写真一覧</a>
  <header class="album-heading"><span class="album-heading-number">{String(number).padStart(2,'0')}</span><div><p class="photo-kicker">PHOTOGRAPHIC RECORD / {entry.data.year_tag}</p><h1>{title}</h1><div class="album-metadata"><time datetime={entry.data.date}>{entry.data.date?.replaceAll('-','.')}</time><span>{locale(entry.data.location)}</span><span>{images.length} PHOTOS</span></div></div></header>
  {entry.body?.trim() && <div class="album-prose"><Content /></div>}
  <PhotoGallery images={images} albumTitle={title} />
  <nav class="album-adjacent" aria-label="アルバムのナビゲーション"><div>{previous && <a href={'/photos/' + previous.slug}><Icon name="lucide:arrow-left" /><span><small>NEWER ALBUM</small>{locale(previous.data.title)}</span></a>}</div><div>{next && <a href={'/photos/' + next.slug}><span><small>OLDER ALBUM</small>{locale(next.data.title)}</span><Icon name="lucide:arrow-right" /></a>}</div></nav>
</EditorialLayout>
