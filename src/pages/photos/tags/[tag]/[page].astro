---
import { getCollection } from 'astro:content';
import PhotoIndex from '../../../../components/PhotoIndex.astro';
export async function getStaticPaths({ paginate }) {
  const albums = await getCollection('photos');
  const keys = ['location_tag', 'year_tag', 'collection_tag'];
  const tags = [...new Set(albums.flatMap(p => keys.map(key => p.data[key])).filter(Boolean))];
  return tags.flatMap(tag => paginate(albums.filter(p => keys.some(key => p.data[key] === tag)).sort((a,b) => Date.parse(b.data.date) - Date.parse(a.data.date)), { params: { tag }, pageSize: 3 }));
}
---
<PhotoIndex page={Astro.props.page} tag={Astro.params.tag} />
