---
// src/pages/[lang]/changelog.astro
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { getCollection, render } from 'astro:content';
import { SITE_CONFIG } from '../../data/site-config';

// 1. 生成多语言路径
export async function getStaticPaths() {
    return [{ params: { lang: 'ja' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'ja' | 'en' };

// 2. 翻译辅助函数 (从配置文件读取)
const t = (key: string) => {
    const labels = SITE_CONFIG.ui.labels as any;
    const headings = SITE_CONFIG.ui.headings as any;
    return labels[key]?.[lang] || headings[key]?.[lang] || key;
};

// 3. 获取并过滤当前语言的日志
const allLogs = await getCollection('changelog', ({ data }) => data.lang === lang);

// 4. 按日期倒序排序
const sortedLogs = allLogs.sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const logs = await Promise.all(sortedLogs.map(async log => ({...log, Content:(await render(log)).Content})));
---
<EditorialLayout lang={lang} title={lang === 'ja' ? '更新履歴' : 'Changelog'} description={t('changelogIntro')}>
  <div class="changelog-page">
    <header class="changelog-heading">
      <p class="kicker">CHANGELOG</p>
      <h1>{lang === 'ja' ? '更新履歴' : 'Changelog'}</h1>
      <p class="intro">{t('changelogIntro')}</p>
    </header>
    <div class="log-list">
      {logs.map(log => <article class="log-entry" id={'release-'+log.data.version}>
        <aside class="log-meta"><time datetime={log.data.date}>{log.data.date.replaceAll('-', '.')}</time><span class="version">{log.data.version}</span><span class="change-type">{log.data.type}</span></aside>
        <div class="log-main"><h2>{log.data.title}</h2><div class="log-content"><log.Content /></div></div>
      </article>)}
    </div>
  </div>
</EditorialLayout>
<style>
.changelog-page { max-width:1040px; margin:auto; padding:16px 0 64px; }
.changelog-heading { margin-bottom:48px; }
.kicker { font-size:12px; letter-spacing:.16em; color:var(--muted); }
h1 { font-size:clamp(34px,5vw,52px); font-weight:600; line-height:1.4; margin:16px 0 22px; }
.intro { font-size:16px; line-height:1.9; color:var(--muted); }
.log-entry { display:grid; grid-template-columns:150px minmax(0,1fr); gap:48px; padding:40px 0 48px; border-top:1px solid var(--rule); scroll-margin-top:24px; }
.log-meta { display:flex; flex-direction:column; align-items:flex-start; gap:12px; font-size:13px; line-height:1.6; }
.log-meta time { font-weight:500; }
.version { color:var(--vermillion); }
.change-type { color:var(--muted); text-transform:uppercase; font-size:10px; letter-spacing:.12em; }
.log-main { min-width:0; }
h2 { font-size:clamp(22px,2.5vw,28px); font-weight:600; line-height:1.65; margin:0 0 28px; overflow-wrap:anywhere; }
.log-content { font-size:16px; line-height:1.95; overflow-wrap:anywhere; }
.log-content :global(p) { margin:0 0 1.3em; }
.log-content :global(h2),.log-content :global(h3) { font-size:19px; font-weight:600; line-height:1.7; margin:32px 0 14px; }
.log-content :global(ul),.log-content :global(ol) { padding-left:1.4em; margin:18px 0 26px; }
.log-content :global(ul) { list-style:disc; }
.log-content :global(ol) { list-style:decimal; }
.log-content :global(li) { padding-left:4px; margin-bottom:14px; }
.log-content :global(a) { color:var(--vermillion); text-decoration:underline; text-underline-offset:4px; }
.log-content :global(strong) { font-weight:600; }
.log-content :global(pre) { overflow:auto; padding:16px; }
.log-content :global(img) { max-width:100%; height:auto; }
.log-content :global(> :last-child) { margin-bottom:0; }
@media(max-width:680px) { .changelog-heading { margin-bottom:32px; } .log-entry { grid-template-columns:1fr; gap:20px; padding:28px 0 36px; } .log-meta { flex-direction:row; flex-wrap:wrap; align-items:center; gap:16px; } .log-content { font-size:15px; } }
</style>
