---
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { getVideoLibrary } from '../data/video-library';

const categoryLabels: Record<string, string> = { APP: 'アプリ', PODCAST: 'ポッドキャスト', VLOG: 'Vlog' };
const videos = (await getVideoLibrary())
    .filter(item => item.lang === 'ja')
    .map(item => {
        const original = item.video?.data.category;
        const category = item.type === 'short' ? 'ショート動画'
            : item.review ? '日本語学習'
            : original ? categoryLabels[original] ?? original : 'その他';
        return { item, category };
    });
const categories = [...new Set(videos.map(video => video.category))];
---
<EditorialLayout title="動画" description="いつきの動画ライブラリ。動画の視聴、日本語の台本と学習ポイント、字幕のふりかえり。" hideHeader>
  <header class="library-header">
    <div><p class="eyebrow" lang="en">VIDEO LIBRARY</p><h1>動画</h1></div>
    <p>日々の記録と、日本語の練習。<br />動画を見ながら、台本や表現をふりかえります。</p>
    <a href="https://www.youtube.com/@Itsuki-no-Nihonggo/videos">YouTube チャンネル<Icon name="lucide:arrow-up-right" /></a>
  </header>

  <section class="library-results" aria-label="動画一覧">
    <div class="library-controls" data-video-controls hidden>
      <label>
        カテゴリ
        <select data-video-filter aria-controls="video-list">
          <option value="">すべて</option>
          {categories.map(category => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label>
        公開日
        <select data-video-sort aria-controls="video-list">
          <option value="newest">新しい順</option>
          <option value="oldest">古い順</option>
        </select>
      </label>
      <p class="video-count" role="status" data-video-count>{videos.length}件</p>
    </div>
    <ul id="video-list" class="grid">
      {videos.map(({ item, category }) => (
        <li data-video-category={category}><VideoCard item={item} category={category} /></li>
      ))}
    </ul>
  </section>

<!-- 4. AI 助手 UI (悬浮窗) -->
<div id="ai-chat-window" class="fixed bottom-24 right-6 w-80 max-h-[450px] bg-[#313244]/95 border border-white/10 rounded-[2.5rem] shadow-2xl flex-col overflow-hidden text-left hidden backdrop-blur-2xl z-[120]">
<div class="p-5 border-b border-white/5 flex justify-between items-center bg-red/5">
<h4 class="text-xs font-black text-red flex items-center gap-2 uppercase tracking-widest">
<div class="w-1.5 h-1.5 rounded-full bg-red animate-pulse"></div>
庭園の精霊
</h4>
<button id="close-ai" class="p-1.5 hover:bg-white/10 rounded-full transition text-white/30 hover:text-white">
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    </div>
    <div id="ai-messages" class="flex-1 p-5 overflow-y-auto scroller space-y-4 text-[11px] leading-relaxed">
<div class="ai-bubble p-3 text-[#a6adc8] bg-white/5 rounded-2xl rounded-tl-none border border-white/5">
    どのような動画スタイルがお好きですか？
    </div>
    </div>
    <div class="p-4 bg-white/[0.02] border-t border-white/5 flex gap-2">
<input type="text" id="ai-input" class="flex-1 bg-white/5 border border-white/10 rounded-2xl px-4 py-2 text-xs text-white placeholder:text-gray-600 focus:outline-none focus:border-red/40 transition-all font-medium" placeholder="質問を入力...">
<button id="send-ai" class="p-2.5 bg-red text-[#1e1e2e] rounded-2xl hover:opacity-90 transition shadow-lg active:scale-95">
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
    </button>
    </div>
    </div>

    <!-- AI 切换按钮 -->
    <button id="toggle-ai" class="fixed bottom-6 right-6 w-14 h-14 bg-red text-[#1e1e2e] rounded-2xl flex items-center justify-center shadow-[0_0_30px_rgba(243,139,168,0.3)] hover:scale-110 active:scale-95 transition-all z-[110]">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
    </button>

    <script is:inline>
// AI 助手客户端逻辑
const toggleBtn = document.getElementById('toggle-ai');
const closeBtn = document.getElementById('close-ai');
const chatWin = document.getElementById('ai-chat-window');
const sendBtn = document.getElementById('send-ai');
const inputField = document.getElementById('ai-input');
const msgBox = document.getElementById('ai-messages');

function toggleChat() {
    const isHidden = chatWin.classList.contains('hidden');
    chatWin.classList.toggle('hidden', !isHidden);
    chatWin.style.display = isHidden ? 'flex' : 'none';
}

function appendMsg(role, text) {
    const div = document.createElement('div');
    div.className = role === 'ai'
        ? 'ai-bubble p-3 text-[#a6adc8] bg-white/5 rounded-2xl rounded-tl-none border border-white/5 shadow-sm'
        : 'user-bubble p-3 text-white bg-red/10 rounded-2xl rounded-tr-none border border-red/10 ml-8 text-right font-bold shadow-sm';
    div.innerText = text;
    msgBox.appendChild(div);
    msgBox.scrollTop = msgBox.scrollHeight;
}

async function handleSend() {
    const val = inputField.value.trim();
    if (!val) return;
    appendMsg('user', val);
    inputField.value = '';

    // 模拟 AI 响应逻辑
    setTimeout(() => {
        const resp = "映像制作のご質問ですね！現在、新しい機材レビューを準備中です。";
        appendMsg('ai', resp);
    }, 800);
}

toggleBtn?.addEventListener('click', toggleChat);
closeBtn?.addEventListener('click', toggleChat);
sendBtn?.addEventListener('click', handleSend);
inputField?.addEventListener('keypress', (e) => e.key === 'Enter' && handleSend());
</script>
</EditorialLayout>

<script>
  const controls = document.querySelector<HTMLElement>('[data-video-controls]');
  const filter = controls?.querySelector<HTMLSelectElement>('[data-video-filter]');
  const sort = controls?.querySelector<HTMLSelectElement>('[data-video-sort]');
  const count = controls?.querySelector<HTMLElement>('[data-video-count]');
  const list = document.querySelector('#video-list');

  if (controls && filter && sort && count && list) {
    const newestFirst = Array.from(list.querySelectorAll<HTMLLIElement>('[data-video-category]'));
    const oldestFirst = [...newestFirst].reverse();
    const url = new URL(window.location.href);
    const category = url.searchParams.get('category') ?? '';
    if (Array.from(filter.options).some(option => option.value === category)) filter.value = category;
    sort.value = url.searchParams.get('order') === 'oldest' ? 'oldest' : 'newest';

    const applyCategory = () => {
      let visible = 0;
      for (const video of newestFirst) {
        video.hidden = !!filter.value && video.dataset.videoCategory !== filter.value;
        if (!video.hidden) visible++;
      }
      count.textContent = `${visible}件`;
    };
    const applyOrder = () => {
      list.append(...(sort.value === 'oldest' ? oldestFirst : newestFirst));
    };
    const updateUrl = () => {
      if (filter.value) url.searchParams.set('category', filter.value);
      else url.searchParams.delete('category');
      if (sort.value === 'oldest') url.searchParams.set('order', 'oldest');
      else url.searchParams.delete('order');
      history.replaceState(history.state, '', url);
    };

    filter.addEventListener('change', () => { applyCategory(); updateUrl(); });
    sort.addEventListener('change', () => { applyOrder(); updateUrl(); });
    if (sort.value === 'oldest') applyOrder();
    applyCategory();
    controls.hidden = false;
  }
</script>

<style>
  .scroller::-webkit-scrollbar { width:4px; }
  .scroller::-webkit-scrollbar-thumb { background:#ffffff1a; border-radius:10px; }
  .library-header { display:flex; flex-wrap:wrap; align-items:end; gap:16px 36px; padding-bottom:22px; border-bottom:2px solid var(--ink); }
  .eyebrow { color:var(--vermillion); letter-spacing:.12em; font-size:12px; font-weight:700; }
  h1 { font-size:clamp(42px,8vw,76px); line-height:1.12; font-weight:800; }
  .library-header > p { color:var(--muted); font-size:14px; line-height:1.75; }
  .library-header a { display:inline-flex; align-items:center; gap:5px; margin-left:auto; font-size:13px; color:var(--vermillion); }
  .library-header a :global(svg) { width:14px; height:14px; }
  .library-results { margin-top:24px; }
  .library-controls { display:flex; flex-wrap:wrap; align-items:end; gap:10px 18px; margin-bottom:22px; }
  .library-controls[hidden], .grid > li[hidden] { display:none; }
  .library-controls label { display:grid; gap:5px; font-size:12px; font-weight:600; color:var(--muted); }
  .library-controls select { min-height:42px; padding:6px 12px; border:1px solid var(--rule); border-radius:4px; background:var(--paper); color:var(--ink); font-size:14px; }
  .library-controls select:focus-visible { outline:2px solid var(--vermillion); outline-offset:2px; }
  .video-count { margin-left:auto; padding-bottom:8px; font-size:13px; color:var(--muted); font-variant-numeric:tabular-nums; }
  .grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
  .grid > li { display:grid; min-width:0; }
  @media(max-width:820px) { .grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:540px) {
    .library-header { display:grid; gap:10px; }
    .library-header a { margin:0; }
    .grid { grid-template-columns:minmax(0,1fr); }
  }
</style>
