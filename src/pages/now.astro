---
import { getCollection } from 'astro:content';
import EditorialLayout from '../layouts/EditorialLayout.astro';
const entries = await getCollection('now', ({ data }) => data.lang === 'ja');
const mission = entries.find(e => e.data.type === 'mission');
const reading = entries.filter(e => e.data.category === 'reading');
const leisure = entries.filter(e => e.data.type === 'status' && e.data.category !== 'reading');
const archive = (await getCollection('archive')).sort((a,b) => Date.parse(b.data.date) - Date.parse(a.data.date));
const groups = [{type:'books',label:'読んだ本'}, {type:'games',label:'ゲームの記録'}, {type:'movies',label:'観た映画'}];
---
<EditorialLayout title="現在">
<div class="now-page">
  <header class="now-heading">
    <div class="now-kicker"><span>NOW / 現在</span>{mission?.data.updated && <time datetime={mission.data.updated}>{mission.data.updated.replaceAll('-', '.')} 更新</time>}</div>
    <h1>{mission?.data.title}</h1>
    <p>{mission?.data.description}</p>
    <div class="now-context"><span>日本語学校で勉強中</span><a href="/about">私について ↗</a></div>
  </header>
  <section class="now-section" aria-labelledby="reading-title">
    <header><span class="section-label">READING</span><h2 id="reading-title">いま読んでいる本</h2></header>
    <div class="reading-list">{reading.map((book,i) => <article class="book-row">
      <div class="book-mark" aria-hidden="true"><span>読書</span><b>0{i+1}</b></div>
      <div><span class="status">読書中</span><h3>{book.data.title}</h3>{book.data.author && <p>{book.data.author}</p>}</div>
    </article>)}</div>
  </section>
  <section class="now-section" aria-labelledby="leisure-title">
    <header><span class="section-label">OFF TIME</span><h2 id="leisure-title">息抜き</h2></header>
    <div>{leisure.map(item => <article class="leisure-row">
      {item.data.cover && <img src={item.data.cover} alt="" width="84" height="112" loading="lazy" />}
      <div><span class="status">ゲーム</span><h3>{item.data.title}</h3><p>{item.data.platform}</p></div>
    </article>)}</div>
  </section>
  <section class="now-section history" aria-labelledby="history-title">
    <header><span class="section-label">PAST NOTES</span><h2 id="history-title">これまでの記録</h2></header>
    <div>{groups.map(group => <details open={group.type === 'books'}>
      <summary>{group.label}<span>{archive.filter(a=>a.data.type===group.type).length}</span></summary>
      <ul>{archive.filter(a=>a.data.type===group.type).map(item => <li><div><h3>{item.data.title}</h3><p>{item.data.meta}</p>{item.data.hasReview && item.data.reviewLink && <a href={item.data.reviewLink}>感想を読む ↗</a>}</div><span class="status">{item.data.status}</span></li>)}</ul>
    </details>)}</div>
  </section>
</div>
</EditorialLayout>
<style>
.now-page{max-width:960px;margin:auto;padding:12px 0 40px}.now-heading{max-width:760px;margin-bottom:64px}.now-kicker{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;font-size:12px;letter-spacing:.1em;color:var(--muted)}h1{font-size:clamp(30px,4vw,48px);line-height:1.5;letter-spacing:-.03em;margin:24px 0} .now-heading p{font-size:17px;line-height:2;max-width:640px}.now-context{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px;font-size:13px}.now-context a{color:var(--vermillion)}.now-section{display:grid;grid-template-columns:180px minmax(0,1fr);gap:40px;border-top:1px solid var(--rule);padding:32px 0 40px}.section-label{font-size:11px;letter-spacing:.14em;color:var(--muted)}h2{font-size:19px;font-weight:600;margin-top:10px}h3{font-size:19px;line-height:1.75;font-weight:500;overflow-wrap:anywhere;margin:6px 0}.reading-list{display:grid;gap:28px}.book-row,.leisure-row{display:flex;align-items:center;gap:24px}.book-mark{width:76px;height:106px;flex-shrink:0;background:#f0eee7;border-left:3px solid var(--vermillion);padding:12px;display:flex;flex-direction:column;justify-content:space-between}.book-mark span{font-size:11px;color:var(--muted)}.book-mark b{font-family:'Barlow Condensed',sans-serif;font-weight:400;font-size:36px}.status{font-size:12px;color:var(--muted);white-space:nowrap}article p,li p{font-size:13px;color:var(--muted);margin:5px 0}.leisure-row img{width:76px;height:106px;object-fit:cover}.history details{border-bottom:1px solid var(--rule);padding:0 0 16px;margin-bottom:20px}.history summary{cursor:pointer;font-size:15px}.history summary span{margin-left:14px;font-size:12px;color:var(--muted)}ul{list-style:none;padding:0;margin:20px 0 0}li{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:12px 0}li h3{font-size:16px}li a{font-size:13px;color:var(--vermillion)}@media(max-width:680px){.now-heading{margin-bottom:40px}.now-section{grid-template-columns:1fr;gap:24px;padding:24px 0 32px}.book-row,.leisure-row{gap:18px}h3{font-size:17px}.now-heading p{font-size:16px}.history li{gap:12px}}
</style>
