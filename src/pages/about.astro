---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { careerProfile, resumeContent } from '../data/resume';

const profile = (await getEntry('about', 'profile'))?.data;
const bio = await getEntry('about', 'bio');
const Bio = bio ? (await render(bio)).Content : null;
interface JourneyItem { date: string; location: string; title: string; desc: string; }
const journey: JourneyItem[] = (await getEntry('about', 'journey'))?.data.items ?? [];
---
<EditorialLayout title="私について" description="樹（Itsuki / CAO FENG）。東京で暮らすソフトウェアエンジニア。日々の記録、写真、日本語の学びと、つくっているもの。">
  <article class="about-page">
    <header class="about-hero">
      <div><p class="kicker">ABOUT / 私について</p><h1><span>こんにちは、</span><span>樹です。</span></h1><p class="identity">{careerProfile.alias} <span>/ {careerProfile.name}</span></p><p class="opening">日々の記録と、つくっているもの。<br />暮らしながら学び、気づいたことを残しています。</p></div>
      {profile?.avatar && <img src={profile.avatar} alt="樹のプロフィール画像：探偵帽をかぶった猫" width="200" height="200" />}
    </header>
    <div class="about-copy">{Bio && <Bio />}</div>
    <section class="about-section" aria-labelledby="work-heading">
      <h2 id="work-heading">エンジニアとして</h2>
      <div><p>{resumeContent.ja.summary}</p><a class="text-link" href="/resume">エンジニアとしての経歴を見る<Icon name="lucide:arrow-up-right" /></a><p class="language-note">日本語・中文・English</p></div>
    </section>
    <section class="about-section" aria-labelledby="interests-heading">
      <h2 id="interests-heading">日々の関心</h2>
      <div class="interest-list">
        <a href="/projects"><h3>つくる<Icon name="lucide:arrow-up-right" /></h3><p>日本語の学び、旅、日々の記録から生まれたアプリやサイト。</p></a>
        <a href="/photos"><h3>写真と旅<Icon name="lucide:arrow-up-right" /></h3><p>街を歩きながら、光や風景、その日の気配を残すこと。</p></a>
        <a href="https://haiku.erzhiqian.cc/" target="_blank" rel="noreferrer"><h3>俳句を書く<Icon name="lucide:arrow-up-right" /></h3><p>日々の小さな発見を、日本語の短い言葉に。</p></a>
      </div>
    </section>
    <section class="about-section" aria-labelledby="journey-heading">
      <h2 id="journey-heading">これまで</h2>
      <div><p>広州でのエンジニア生活を経て、2026年4月に日本へ。いまは東京で、日本語を学びながら暮らしています。</p><a class="text-link" href="/now">現在のこと<Icon name="lucide:arrow-up-right" /></a>
        <details class="journey"><summary>これまでの歩みを見る<span>{journey.length} の記録</span></summary><ol>{journey.map(item => <li><div class="journey-date">{item.date} · {item.location}</div><h3>{item.title}</h3><p>{item.desc}</p></li>)}</ol></details>
      </div>
    </section>
    <section class="about-section" aria-labelledby="contact-heading"><h2 id="contact-heading">ご連絡</h2><div><p>仕事や制作についてのご連絡は、メールでどうぞ。</p><a class="text-link" href={`mailto:${careerProfile.email}`}>{careerProfile.email}<Icon name="lucide:arrow-up-right" /></a></div></section>
  </article>
</EditorialLayout>
<style>
.about-page{max-width:960px;margin:auto;padding:16px 0 48px}.about-hero{display:grid;grid-template-columns:minmax(0,1fr) 160px;gap:48px;align-items:center;margin-bottom:40px}.about-hero img{width:160px;height:160px;object-fit:cover}.kicker{font-size:12px;color:var(--muted);letter-spacing:.08em;margin:0 0 24px}h1 span{display:inline-block}h1{font-size:clamp(30px,4vw,46px);font-weight:600;line-height:1.5;margin:0 0 16px}.identity{font-size:16px;margin:0 0 24px}.identity span{color:var(--muted);font-size:14px}.opening{font-size:18px;line-height:1.9;margin:0}.about-copy{max-width:720px;font-size:16px;line-height:2;margin-bottom:40px}.about-copy :global(p){margin:0 0 20px}.about-section{display:grid;grid-template-columns:168px minmax(0,1fr);gap:48px;border-top:1px solid var(--rule);padding:36px 0}.about-section h2{font-size:16px;font-weight:500;line-height:1.8;margin:0}.about-section p{font-size:16px;line-height:1.9;margin:0 0 16px}.about-section>div{min-width:0}.about-page .text-link{display:inline-flex;align-items:center;gap:8px;color:var(--vermillion);border-bottom:1px solid currentColor;padding-bottom:6px;font-size:14px;overflow-wrap:anywhere}.about-section .language-note{font-size:12px;color:var(--muted);margin-top:12px}.interest-list{display:grid;grid-template-columns:1fr 1fr;gap:24px 32px}.interest-list h3{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:500;margin:0 0 10px}.interest-list p{font-size:14px;color:var(--muted);margin:0}.journey{margin-top:28px;border-top:1px solid var(--rule)}.journey summary{padding:18px 0;cursor:pointer;font-size:14px;line-height:1.8}.journey summary span{color:var(--muted);font-size:12px;margin-left:14px}.journey ol{list-style:none;margin:8px 0 0;padding:0 0 0 20px;border-left:1px solid var(--rule)}.journey li+li{margin-top:28px}.journey-date{font-size:12px;color:var(--muted)}.journey h3{font-size:16px;font-weight:500;margin:8px 0}.journey p{font-size:14px;color:var(--muted)}
@media(max-width:760px){.about-hero{display:block;position:relative;margin-bottom:28px}.about-hero img{position:absolute;top:0;right:0;width:76px;height:76px;margin:0}.about-hero .kicker{min-height:76px;padding-top:8px;padding-right:92px}h1{font-size:29px}.opening{font-size:16px}.identity span{display:block;margin-top:6px}.about-section{grid-template-columns:1fr;gap:20px;padding:28px 0}.interest-list{grid-template-columns:1fr;gap:24px}.about-hero h1{overflow-wrap:anywhere}.kicker{margin-bottom:16px}.about-section h2{color:var(--muted)}}

</style>
