---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, getEntry, render } from 'astro:content';
const copy = (await getEntry('page-copy', 'projects')).data;
const entries = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const projects = await Promise.all(entries.map(async entry=>({...entry.data, Content:(await render(entry)).Content})));
---
<EditorialLayout title={copy.title} description={copy.description}>
<div class="projects-page">
  <header class="projects-heading"><p class="kicker">{copy.kicker}</p><h1>{copy.title}</h1><p class="intro">{copy.intro}</p></header>
  <nav class="project-index" aria-label="プロジェクト一覧">{projects.map(p=><a href={'#'+p.id}>{p.name}<span>↓</span></a>)}</nav>
  {projects.map((project,i) => <section id={project.id} class="project-detail" aria-labelledby={project.id+'-title'}>
    <div class="project-label"><span class="number">0{i+1}</span><Icon name={'lucide:'+project.icon} /><p>{project.kind}</p></div>
    <div class="project-body"><h2 id={project.id+'-title'}>{project.name}</h2><p class="tagline">{project.description}</p><div class="description"><project.Content /></div><a class="project-link" href={project.href} target="_blank" rel="noreferrer">{project.action}<Icon name="lucide:arrow-up-right" /></a></div>
  </section>)}
</div>
</EditorialLayout>
<style>
.description :global(.project-screenshots){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:32px 0}
.description :global(figure){margin:0;max-width:240px}
.description :global(img){display:block;width:100%;height:auto;border:1px solid var(--rule);border-radius:12px;cursor:zoom-in}
.description :global(figcaption){font-size:12px;line-height:1.7;margin-top:10px;color:var(--muted)}

.projects-page{max-width:1040px;margin:auto;padding:16px 0 48px}.projects-heading{margin-bottom:36px}.kicker{font-size:12px;letter-spacing:.15em;color:var(--muted)}h1{font-size:clamp(40px,6vw,68px);font-weight:600;margin:16px 0 24px}.intro{font-size:18px;line-height:2}.project-index{display:flex;flex-wrap:wrap;gap:16px 28px;padding:22px 0;border-top:1px solid var(--rule);margin-bottom:24px;font-size:13px}.project-index a{display:flex;gap:12px}.project-index span{color:var(--vermillion)}.project-detail{display:grid;grid-template-columns:200px minmax(0,1fr);gap:48px;border-top:1px solid var(--rule);padding:48px 0 56px;scroll-margin-top:28px}.project-label{display:flex;align-items:baseline;flex-wrap:wrap;gap:20px;align-content:start}.number{font-family:'Barlow Condensed',sans-serif;font-size:48px;line-height:1;color:var(--muted)}.project-label :global(svg){width:28px;height:28px;color:var(--vermillion)}.project-label p{width:100%;font-size:12px;color:var(--muted)}h2{font-size:clamp(25px,3vw,34px);line-height:1.5;margin:0 0 16px;font-weight:600}.tagline{font-size:18px;line-height:1.8;margin-bottom:20px}.description{font-size:16px;line-height:2;color:var(--muted)}.description :global(ul){padding-left:20px;margin:24px 0;list-style:disc;font-size:14px;line-height:1.9}.description :global(li+li){margin-top:6px}.project-link{display:inline-flex;gap:12px;align-items:center;color:var(--vermillion);font-size:14px;border-bottom:1px solid var(--vermillion);padding:8px 0}.project-link :global(svg){width:18px;height:18px}@media(max-width:680px){.project-detail{grid-template-columns:1fr;gap:20px;padding:32px 0 40px}.project-label{align-items:center;gap:14px}.project-label p{width:auto}.number{font-size:30px}.intro{font-size:16px}.tagline{font-size:17px}}
</style>
