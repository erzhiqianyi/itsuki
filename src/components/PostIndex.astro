---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { postCategoryLabel as label } from '../lib/post-filter';
import { SITE_CONFIG } from '../data/site-config';
import '../styles/post-index.css';
const { page, category } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => data.lang === 'ja');
const categories = [...new Set(allPosts.map(p => p.data.category.toLowerCase()))];
const base = category ? '/category/' + category : '/blog';
const pageHref = (n) => n === 1 ? base : base + '/' + n;
const numbers = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(n => n === 1 || n === page.lastPage || Math.abs(n - page.currentPage) <= 1);
const entries = await Promise.all(page.data.map(async post => ({ post, excerpt: post.data.summary || (await render(post)).headings.filter(h => h.depth <= 3).slice(0, 5).map(h => h.text).join(' / ') })));
---
<EditorialLayout title={category ? label(category) : '記事'} hideHeader>
  <div class="post-index" data-post-index data-category={category || ''} data-base={base} data-page={page.currentPage} data-page-size={SITE_CONFIG.blog.pageSize}>
    <header class="index-title"><span class="display-type">01</span><h1>{category ? label(category) : '記事'}</h1><p data-post-total>{category ? allPosts.filter(p => p.data.category.toLowerCase() === category).length : allPosts.length} 記事</p></header>
    <nav class="index-categories" data-post-categories aria-label="カテゴリー"><a href="/blog" aria-current={!category ? 'page' : undefined}>すべて</a>{categories.map(c => <a href={'/category/' + c} aria-current={category === c ? 'page' : undefined}>{label(c)}</a>)}<a href="/blog/featured">おすすめ</a></nav>
    <div data-post-tools hidden>
      <button type="button" class="post-filters-toggle" aria-expanded="false" aria-controls="post-filters-panel"><span>絞り込み・並び順</span><Icon name="lucide:chevron-down" /></button>
      <div class="post-filters" id="post-filters-panel" aria-label="記事の絞り込み">
        <div class="post-filter-row"><span class="filter-label" id="post-year-label">YEAR</span><div class="filter-options" data-year-options role="group" aria-labelledby="post-year-label"></div><div class="post-sort" role="group" aria-label="並び順"><button type="button" data-post-sort="desc" aria-label="新しい順" title="新しい順" aria-pressed="true"><Icon name="lucide:arrow-down-wide-narrow" /><span>新しい順</span></button><button type="button" data-post-sort="asc" aria-label="古い順" title="古い順" aria-pressed="false"><Icon name="lucide:arrow-up-narrow-wide" /><span>古い順</span></button></div></div>
        <div class="post-filter-row"><label class="filter-label" for="post-month">MONTH</label><select id="post-month" aria-label="月で絞り込む"><option value="">すべての月</option></select></div>
        <div class="post-filter-row"><span class="filter-label" id="post-tag-label">TAG</span><div class="filter-options post-tag-options" id="post-tag-options" data-tag-options role="group" aria-labelledby="post-tag-label"></div><button type="button" class="post-tags-more" aria-expanded="false" aria-controls="post-tag-options" hidden>もっと見る</button></div>
      </div>
      <div class="post-results-bar"><p data-post-status role="status" aria-live="polite" aria-atomic="true"></p><button type="button" data-post-reset hidden>絞り込みをクリア</button></div>
    </div>
    <p data-post-error role="status" hidden>絞り込みを読み込めませんでした。<button type="button" data-post-retry>再読み込み</button></p>
    <p class="post-empty" data-post-empty hidden>条件に合う記事がありません。時間やタグを変更するか、絞り込みをクリアしてください。</p>
    <template data-post-template><article><time></time><div><span class="entry-pin" data-entry-pin hidden>固定 · シリーズ案内</span><h2><a data-entry-title></a></h2><p data-entry-excerpt></p><a class="entry-category" data-entry-category></a></div><a class="entry-arrow" data-entry-arrow><Icon name="lucide:arrow-up-right" /></a></article></template>
    <div class="index-entries" data-post-entries>{entries.map(({ post, excerpt }) => <article><time datetime={post.data.date}>{post.data.date?.replaceAll('-', '.')}</time><div>{category && post.data.pinnedInCategory && <span class="entry-pin">固定 · シリーズ案内</span>}<h2><a href={'/blog/' + post.id.replace(/\.(md|mdx)$/, '')}>{post.data.title || post.data.date}</a></h2>{excerpt && <p>{excerpt}</p>}<a class="entry-category" href={'/category/' + post.data.category.toLowerCase()}>{label(post.data.category.toLowerCase())}</a></div><a class="entry-arrow" href={'/blog/' + post.id.replace(/\.(md|mdx)$/, '')} aria-label={(post.data.title || post.data.date) + 'を読む'}><Icon name="lucide:arrow-up-right" /></a></article>)}</div>
    <nav class="index-pages" data-post-pages aria-label="ページ切り替え">{page.url.prev && <a href={page.url.prev} aria-label="前のページ"><Icon name="lucide:arrow-left" /></a>}{numbers.map((n, i) => <>{i > 0 && n - numbers[i - 1] > 1 && <span>…</span>}<a href={pageHref(n)} aria-current={n === page.currentPage ? 'page' : undefined}>{n}</a></>)}{page.url.next && <a href={page.url.next} aria-label="次のページ"><Icon name="lucide:arrow-right" /></a>}</nav>
  </div>
</EditorialLayout>

<script>
  import '../scripts/post-index';
</script>
