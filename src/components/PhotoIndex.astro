---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PhotoFilters from './PhotoFilters.astro';
import '../styles/photography.css';
import { photoPreview } from './photo-preview';
const { page, tag } = Astro.props;
const locale = value => typeof value === 'string' ? value : value?.ja || value?.en || '';
// Prefer the images[] entry for the cover so its recorded width/height come along.
const coverOf = album => album.data.images?.find(photo => photo.url === album.data.cover) || (album.data.cover ? {url:album.data.cover} : album.data.images?.[0]);
const covers = await Promise.all(page.data.map(album => photoPreview(coverOf(album))));
---
<EditorialLayout title={tag ? `写真 / ${tag}` : '写真'} hideHeader>
  <PhotoFilters tag={tag} />
  <div class="album-index" data-sortable-grid>{page.data.map((album,index) => <article class="album-sheet" data-date={album.data.date}><a href={`/photos/${album.slug}`}><figure class="album-print">{album.data.locked ? <div class="album-locked-fill"><Icon name="lucide:lock" /><span>PASSWORD PROTECTED</span></div> : <img {...covers[index]} alt={locale(album.data.title)} loading={index < 3 ? 'eager' : 'lazy'} />}<span class="album-count">{album.data.locked && <Icon name="lucide:lock" />}{String(album.data.locked ? (album.data.imageCount || 0) : (album.data.images?.length || 1)).padStart(2,'0')} PHOTOS</span><figcaption class="album-watermark"><time datetime={album.data.date}>{album.data.date?.replaceAll('-','.')}{locale(album.data.location) && ` · ${locale(album.data.location)}`}</time><h2>{locale(album.data.title)}</h2></figcaption></figure></a></article>)}</div>
  {page.lastPage > 1 && <nav class="photo-pagination" aria-label="相冊のページ">{page.url.prev && <a href={page.url.prev} aria-label="前のページ"><Icon name="lucide:arrow-left" /></a>}<span>{page.currentPage} / {page.lastPage}</span>{page.url.next && <a href={page.url.next} aria-label="次のページ"><Icon name="lucide:arrow-right" /></a>}</nav>}
</EditorialLayout>
